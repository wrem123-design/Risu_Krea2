@@ -99,6 +100,32 @@ def _is_number(value: object) -> bool:
     return isinstance(value, (int, float)) and not isinstance(value, bool)
 
 
+def randomize_workflow_seeds(
+    workflow: JsonObject,
+    seed_factory: Callable[[], int] | None = None,
+) -> int:
+    """Replace numeric sampler seeds so ComfyUI cannot reuse stale cache."""
+
+    make_seed = seed_factory or (lambda: secrets.randbelow(2**63))
+    changed = 0
+    for raw_node in workflow.values():
+        if not isinstance(raw_node, dict):
+            continue
+        raw_inputs = raw_node.get("inputs")
+        if not isinstance(raw_inputs, dict):
+            continue
+        for input_name in ("seed", "noise_seed"):
+            current = raw_inputs.get(input_name)
+            if not _is_number(current):
+                continue
+            replacement = int(make_seed())
+            if replacement == current:
+                replacement = (replacement + 1) % (2**63)
+            raw_inputs[input_name] = replacement
+            changed += 1
+    return changed
+
