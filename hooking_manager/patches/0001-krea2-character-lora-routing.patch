@@ -0,0 +1,654 @@
+"""Krea2 character LoRA catalog, persistence, and per-request routing."""
+
+from __future__ import annotations
+
+import copy
+import json
+import math
+import re
+import unicodedata
+from pathlib import Path
+from typing import Literal, TypedDict, cast
+
+
+DYNAMIC_LORA_NODE_TITLE = "Krea2 캐릭터 LoRA (동적)"
+PRESET_MARKER_PATTERN = re.compile(
+    r"^\s*\[\[KREA2_PRESET:([^\]\r\n]{1,32})\]\]\s*",
+    re.IGNORECASE,
+)
+CHARACTER_MARKER_PATTERN = re.compile(
+    r"^\s*\[\[KREA2_CHARACTER:([^\]\r\n]{1,120})\]\]\s*",
+    re.IGNORECASE,
+)
+MULTI_CHARACTER_MARKER_PATTERN = re.compile(
+    r"^\s*\[\[KREA2_MULTI_CHARACTER\]\]\s*",
+    re.IGNORECASE,
+)
+
+
+class CatalogEntry(TypedDict):
+    """A character LoRA discovered in the source Power LoRA Loader."""
+
+    filename: str
+    default_strength: float
+    source_enabled: bool
+
+
+class MappingEntry(TypedDict):
+    """User-editable mapping persisted by Hooking Manager."""
+
+    filename: str
+    character_name: str
+    strength: float
+
+
+class DisplayEntry(MappingEntry):
+    """Merged catalog and mapping data returned to the frontend."""
+
+    default_strength: float
+    source_enabled: bool
+
+
+class Resolution(TypedDict):
+    """Validated Krea2 latent-image dimensions."""
+
+    width: int
+    height: int
+
+
+class LoraSelection(TypedDict):
+    """One LoRA and strength selected for a generated request."""
+
+    filename: str
+    strength: float
+
+
+PresetRoutingMode = Literal["character", "always", "disabled"]
+
+
+class PresetRoute(TypedDict):
+    """Persisted exclusive LoRA behavior for one module preset."""
+
+    preset: str
+    mode: PresetRoutingMode
+    loras: list[LoraSelection]
+
+
+JsonObject = dict[str, object]
+
+
+def _as_object(value: object, label: str) -> JsonObject:
+    """Return a JSON object or fail with a descriptive label."""
+
+    if not isinstance(value, dict):
+        raise ValueError(f"{label} must be an object")
+    return cast(JsonObject, value)
+
+
+def _as_list(value: object, label: str) -> list[object]:
+    """Return a JSON list or fail with a descriptive label."""
+
+    if not isinstance(value, list):
+        raise ValueError(f"{label} must be a list")
+    return cast(list[object], value)
+
+
+def _is_number(value: object) -> bool:
+    """Return whether a JSON value is a non-boolean number."""
+
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+def load_power_lora_catalog(workflow_path: Path) -> list[CatalogEntry]:
+    """Read Krea2 LoRA filenames and defaults from Power LoRA Loader nodes."""
+
+    workflow = _as_object(
+        json.loads(workflow_path.read_text(encoding="utf-8")), "workflow"
+    )
+    nodes = _as_list(workflow.get("nodes", []), "workflow nodes")
+    entries: list[CatalogEntry] = []
+    seen: set[str] = set()
+
+    for raw_node in nodes:
+        node = _as_object(raw_node, "workflow node")
+        if node.get("type") != "Power Lora Loader (rgthree)":
+            continue
+        for raw_widget in _as_list(node.get("widgets_values", []), "widgets values"):
+            if not isinstance(raw_widget, dict):
+                continue
+            widget = cast(JsonObject, raw_widget)
+            filename = widget.get("lora")
+            strength = widget.get("strength")
+            if not isinstance(filename, str) or not _is_number(strength):
+                continue
+            normalized_path = filename.replace("/", "\\")
+            if not normalized_path.casefold().startswith("krea2\\"):
+                continue
+            key = normalized_path.casefold()
+            if key in seen:
+                continue
+            seen.add(key)
+            entries.append(
+                {
+                    "filename": normalized_path,
+                    "default_strength": float(cast(int | float, strength)),
+                    "source_enabled": bool(widget.get("on", False)),
+                }
+            )
+
+    if not entries:
+        raise ValueError(
+            f"No Krea2 character LoRAs were found in {workflow_path}"
+        )
+    return entries
+
+
+def validate_resolution(value: object) -> Resolution:
+    """Validate dimensions supported by the Krea2 latent workflow."""
+
+    resolution = _as_object(value, "resolution")
+    width = resolution.get("width")
+    height = resolution.get("height")
+    if (
+        not isinstance(width, int)
+        or isinstance(width, bool)
+        or not isinstance(height, int)
+        or isinstance(height, bool)
+    ):
+        raise ValueError("Resolution width and height must be integers")
+    if width < 256 or width > 4096 or height < 256 or height > 4096:
+        raise ValueError("Resolution width and height must be between 256 and 4096")
+    if width % 8 != 0 or height % 8 != 0:
+        raise ValueError("Resolution width and height must be multiples of 8")
+    return {"width": width, "height": height}
+
+
+def load_workflow_resolution(workflow_path: Path) -> Resolution:
+    """Read default width and height from the source UI workflow."""
+
+    workflow = _as_object(
+        json.loads(workflow_path.read_text(encoding="utf-8")), "workflow"
+    )
+    nodes = _as_list(workflow.get("nodes", []), "workflow nodes")
+    values: dict[str, int] = {}
+    title_to_key = {"Image Width": "width", "Image Height": "height"}
+    for raw_node in nodes:
+        node = _as_object(raw_node, "workflow node")
+        key = title_to_key.get(node.get("title"))
+        if key is None:
+            continue
+        widgets = _as_list(node.get("widgets_values", []), "resolution widgets")
+        if widgets and isinstance(widgets[0], int) and not isinstance(widgets[0], bool):
+            values[key] = widgets[0]
+    return validate_resolution(values)
+
+
+def normalize_character_name(value: str) -> str:
+    """Normalize a character name for exact, case-insensitive matching."""
+
+    normalized = unicodedata.normalize("NFKC", value)
+    return " ".join(normalized.split()).casefold()
+
+
+def split_character_aliases(value: str) -> list[str]:
+    """Return trimmed comma-separated character aliases."""
+
+    return [" ".join(part.split()) for part in value.split(",") if part.strip()]
+
+
+def normalize_preset_id(value: object) -> tuple[str, str]:
+    """Return a display preset id and its case-insensitive comparison key."""
+
+    if isinstance(value, int) and not isinstance(value, bool):
+        raw = str(value)
+    elif isinstance(value, str):
+        raw = value
+    else:
+        raise ValueError("Preset id must be text or an integer")
+    display = " ".join(unicodedata.normalize("NFKC", raw).split())
+    if (
+        not display
+        or len(display) > 32
+        or any(character in display for character in "[]\r\n")
+    ):
+        raise ValueError("Preset id must be 1 to 32 characters without brackets or newlines")
+    return display, display.casefold()
+
+
+def validate_mapping_entries(
+    catalog: list[CatalogEntry], incoming: list[object]
+) -> list[MappingEntry]:
+    """Validate editable mappings against the immutable workflow catalog."""
+
+    valid_files = {entry["filename"].casefold(): entry["filename"] for entry in catalog}
+    used_files: set[str] = set()
+    used_names: set[str] = set()
+    validated: list[MappingEntry] = []
+
+    for index, raw_entry in enumerate(incoming):
+        entry = _as_object(raw_entry, f"mapping {index}")
+        raw_filename = entry.get("filename")
+        raw_name = entry.get("character_name", "")
+        raw_strength = entry.get("strength")
+        if not isinstance(raw_filename, str) or raw_filename.casefold() not in valid_files:
+            raise ValueError(f"Mapping {index} references an unknown LoRA file")
+        file_key = raw_filename.casefold()
+        if file_key in used_files:
+            raise ValueError(f"Mapping {index} repeats a LoRA file")
+        used_files.add(file_key)
+
+        if not isinstance(raw_name, str):
+            raise ValueError(f"Mapping {index} has an invalid character name")
+        if len(raw_name) > 240 or any(character in raw_name for character in "[]\r\n"):
+            raise ValueError(f"Mapping {index} has an invalid character name")
+        aliases = split_character_aliases(raw_name)
+        if raw_name.strip() and (
+            not aliases
+            or any(not part.strip() for part in raw_name.split(","))
+            or any(len(alias) > 120 for alias in aliases)
+        ):
+            raise ValueError(f"Mapping {index} has an invalid character alias list")
+        character_name = ", ".join(aliases)
+        normalized_aliases = [normalize_character_name(alias) for alias in aliases]
+        if len(normalized_aliases) != len(set(normalized_aliases)):
+            raise ValueError("A character alias can appear only once")
+        for normalized_name in normalized_aliases:
+            if normalized_name in used_names:
+                raise ValueError("Each character name can be assigned to only one LoRA")
+            used_names.add(normalized_name)
+
+        if not _is_number(raw_strength):
+            raise ValueError(f"Mapping {index} has an invalid strength")
+        strength = float(cast(int | float, raw_strength))
+        if not math.isfinite(strength) or strength < 0 or strength > 2:
+            raise ValueError(f"Mapping {index} strength must be between 0 and 2")
+
+        validated.append(
+            {
+                "filename": valid_files[file_key],
+                "character_name": character_name,
+                "strength": strength,
+            }
+        )
+    return validated
+
+
+def validate_preset_routes(
+    catalog: list[CatalogEntry], incoming: list[object]
+) -> list[PresetRoute]:
+    """Validate preset routing modes and selected LoRAs against the catalog."""
+
+    valid_files = {entry["filename"].casefold(): entry["filename"] for entry in catalog}
+    used_presets: set[str] = set()
+    validated: list[PresetRoute] = []
+    valid_modes = {"character", "always", "disabled"}
+
+    for index, raw_route in enumerate(incoming):
+        route = _as_object(raw_route, f"preset route {index}")
+        preset, preset_key = normalize_preset_id(route.get("preset"))
+        mode = route.get("mode")
+        raw_loras = _as_list(route.get("loras", []), f"preset route {index} LoRAs")
+        if preset_key in used_presets:
+            raise ValueError(f"Preset {preset} has more than one routing rule")
+        used_presets.add(preset_key)
+        if not isinstance(mode, str) or mode not in valid_modes:
+            raise ValueError(f"Preset route {index} has an invalid mode")
+
+        used_files: set[str] = set()
+        loras: list[LoraSelection] = []
+        for lora_index, raw_lora in enumerate(raw_loras):
+            lora = _as_object(raw_lora, f"preset route {index} LoRA {lora_index}")
+            raw_filename = lora.get("filename")
+            raw_strength = lora.get("strength")
+            if not isinstance(raw_filename, str) or raw_filename.casefold() not in valid_files:
+                raise ValueError(
+                    f"Preset route {index} LoRA {lora_index} references an unknown file"
+                )
+            file_key = raw_filename.casefold()
+            if file_key in used_files:
+                raise ValueError(f"Preset route {index} repeats a LoRA file")
+            used_files.add(file_key)
+            if not _is_number(raw_strength):
+                raise ValueError(f"Preset route {index} LoRA {lora_index} has an invalid strength")
+            strength = float(cast(int | float, raw_strength))
+            if not math.isfinite(strength) or strength < 0 or strength > 2:
+                raise ValueError(
+                    f"Preset route {index} LoRA {lora_index} strength must be between 0 and 2"
+                )
+            loras.append({"filename": valid_files[file_key], "strength": strength})
+
+        if mode == "always" and not loras:
+            raise ValueError(f"Preset {preset} always mode requires at least one LoRA")
+        validated.append(
+            {
+                "preset": preset,
+                "mode": cast(PresetRoutingMode, mode),
+                "loras": loras,
+            }
+        )
+    return sorted(validated, key=lambda route: normalize_preset_id(route["preset"])[1])
+
+
+def merge_catalog_with_mappings(
+    catalog: list[CatalogEntry], saved: list[MappingEntry]
+) -> list[DisplayEntry]:
+    """Merge immutable catalog metadata with user mapping overrides."""
+
+    saved_by_file = {entry["filename"].casefold(): entry for entry in saved}
+    merged: list[DisplayEntry] = []
+    for catalog_entry in catalog:
+        saved_entry = saved_by_file.get(catalog_entry["filename"].casefold())
+        merged.append(
+            {
+                "filename": catalog_entry["filename"],
+                "character_name": (
+                    saved_entry["character_name"] if saved_entry else ""
+                ),
+                "strength": (
+                    saved_entry["strength"]
+                    if saved_entry
+                    else catalog_entry["default_strength"]
+                ),
+                "default_strength": catalog_entry["default_strength"],
+                "source_enabled": catalog_entry["source_enabled"],
+            }
+        )
+    return merged
+
+
+def load_mapping_file(mapping_path: Path) -> list[MappingEntry]:
+    """Load persisted mappings, returning an empty list before first save."""
+
+    if not mapping_path.is_file():
+        return []
+    payload = _as_object(
+        json.loads(mapping_path.read_text(encoding="utf-8")), "mapping file"
+    )
+    entries = _as_list(payload.get("entries", []), "mapping entries")
+    result: list[MappingEntry] = []
+    for index, raw_entry in enumerate(entries):
+        entry = _as_object(raw_entry, f"saved mapping {index}")
+        filename = entry.get("filename")
+        character_name = entry.get("character_name")
+        strength = entry.get("strength")
+        if (
+            not isinstance(filename, str)
+            or not isinstance(character_name, str)
+            or not _is_number(strength)
+        ):
+            raise ValueError(f"Saved mapping {index} is invalid")
+        result.append(
+            {
+                "filename": filename,
+                "character_name": character_name,
+                "strength": float(cast(int | float, strength)),
+            }
+        )
+    return result
+
+
+def load_preset_routes(mapping_path: Path) -> list[PresetRoute]:
+    """Load preset routing, defaulting only preset 1 to legacy character mode."""
+
+    default: list[PresetRoute] = [
+        {"preset": "1", "mode": "character", "loras": []}
+    ]
+    if not mapping_path.is_file():
+        return default
+    payload = _as_object(
+        json.loads(mapping_path.read_text(encoding="utf-8")), "mapping file"
+    )
+    if "preset_routes" not in payload:
+        return default
+    raw_routes = _as_list(payload.get("preset_routes"), "preset routes")
+    routes: list[PresetRoute] = []
+    for index, raw_route in enumerate(raw_routes):
+        route = _as_object(raw_route, f"saved preset route {index}")
+        preset, _ = normalize_preset_id(route.get("preset"))
+        mode = route.get("mode")
+        raw_loras = _as_list(route.get("loras", []), f"saved preset route {index} LoRAs")
+        if mode not in {"character", "always", "disabled"}:
+            raise ValueError(f"Saved preset route {index} has an invalid mode")
+        loras: list[LoraSelection] = []
+        for lora_index, raw_lora in enumerate(raw_loras):
+            lora = _as_object(raw_lora, f"saved preset route {index} LoRA {lora_index}")
+            filename = lora.get("filename")
+            strength = lora.get("strength")
+            if not isinstance(filename, str) or not _is_number(strength):
+                raise ValueError(
+                    f"Saved preset route {index} LoRA {lora_index} is invalid"
+                )
+            loras.append(
+                {
+                    "filename": filename,
+                    "strength": float(cast(int | float, strength)),
+                }
+            )
+        routes.append(
+            {
+                "preset": preset,
+                "mode": cast(PresetRoutingMode, mode),
+                "loras": loras,
+            }
+        )
+    return routes
+
+
+def load_resolution_override(mapping_path: Path) -> Resolution | None:
+    """Load the optional persisted resolution override."""
+
+    if not mapping_path.is_file():
+        return None
+    payload = _as_object(
+        json.loads(mapping_path.read_text(encoding="utf-8")), "mapping file"
+    )
+    resolution = payload.get("resolution")
+    return validate_resolution(resolution) if resolution is not None else None
+
+
+def save_mapping_file(
+    mapping_path: Path,
+    entries: list[MappingEntry],
+    resolution: Resolution | None = None,
+    preset_routes: list[PresetRoute] | None = None,
+) -> None:
+    """Atomically persist mappings, resolution, and preset routing."""
+
+    mapping_path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = mapping_path.with_suffix(mapping_path.suffix + ".tmp")
+    payload: JsonObject = {"version": 3, "entries": entries}
+    if resolution is not None:
+        payload["resolution"] = validate_resolution(resolution)
+    if preset_routes is not None:
+        payload["preset_routes"] = preset_routes
+    temporary.write_text(
+        json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
+        encoding="utf-8",
+    )
+    temporary.replace(mapping_path)
+
+
+def extract_character_marker(prompt: str) -> tuple[str, str | None]:
+    """Remove a leading module routing marker and return its character name."""
+
+    cleaned, character_name, _ = extract_routing_markers(prompt)
+    return cleaned, character_name
+
+
+def extract_routing_markers(prompt: str) -> tuple[str, str | None, str | None]:
+    """Remove preset and identity markers while retaining legacy preset behavior."""
+
+    remaining = prompt
+    preset: str | None = None
+    preset_match = PRESET_MARKER_PATTERN.match(remaining)
+    if preset_match is not None:
+        preset, _ = normalize_preset_id(preset_match.group(1))
+        remaining = remaining[preset_match.end() :]
+
+    multi_match = MULTI_CHARACTER_MARKER_PATTERN.match(remaining)
+    if multi_match is not None:
+        if preset is None:
+            preset = "1"
+        return remaining[multi_match.end() :].strip(), None, preset
+    match = CHARACTER_MARKER_PATTERN.match(remaining)
+    if match is None:
+        return remaining.strip() if preset is not None else prompt, None, preset
+    if preset is None:
+        preset = "1"
+    character_name = " ".join(match.group(1).split())
+    return remaining[match.end() :].strip(), character_name or None, preset
+
+
+def find_character_mapping(
+    character_name: str | None, mappings: list[MappingEntry]
+) -> MappingEntry | None:
+    """Find a mapping with any exact normalized alias, or return no LoRA."""
+
+    if not character_name:
+        return None
+    expected = normalize_character_name(character_name)
+    if not expected:
+        return None
+    for mapping in mappings:
+        aliases = split_character_aliases(mapping["character_name"])
+        if any(normalize_character_name(alias) == expected for alias in aliases):
+            return mapping
+    return None
+
+
+def resolve_preset_loras(
+    preset: str | None,
+    character_name: str | None,
+    mappings: list[MappingEntry],
+    routes: list[PresetRoute],
+) -> list[LoraSelection]:
+    """Resolve the exclusive preset mode to a request-specific LoRA list."""
+
+    if preset is None:
+        return []
+    _, expected = normalize_preset_id(preset)
+    route = next(
+        (
+            item
+            for item in routes
+            if normalize_preset_id(item["preset"])[1] == expected
+        ),
+        None,
+    )
+    if route is None or route["mode"] == "disabled":
+        return []
+    if route["mode"] == "always":
+        return [dict(selection) for selection in route["loras"]]
+    mapping = find_character_mapping(character_name, mappings)
+    if mapping is None:
+        return []
+    return [{"filename": mapping["filename"], "strength": mapping["strength"]}]
+
+
+def route_character_lora(
+    workflow: JsonObject, mapping: MappingEntry | None
+) -> JsonObject:
+    """Apply exactly one mapped LoRA, or remove and bypass the dynamic node."""
+
+    selections: list[LoraSelection] = []
+    if mapping is not None:
+        selections.append(
+            {"filename": mapping["filename"], "strength": mapping["strength"]}
+        )
+    return route_lora_chain(workflow, selections)
+
+
+def route_lora_chain(
+    workflow: JsonObject, selections: list[LoraSelection]
+) -> JsonObject:
+    """Apply a deterministic dynamic LoRA chain or bypass the template node."""
+
+    routed = cast(JsonObject, copy.deepcopy(workflow))
+    dynamic_id: str | None = None
+    dynamic_node: JsonObject | None = None
+    for node_id, raw_node in routed.items():
+        if not isinstance(raw_node, dict):
+            continue
+        node = cast(JsonObject, raw_node)
+        meta = node.get("_meta")
+        if isinstance(meta, dict) and meta.get("title") == DYNAMIC_LORA_NODE_TITLE:
+            dynamic_id = str(node_id)
+            dynamic_node = node
+            break
+
+    if dynamic_id is None or dynamic_node is None:
+        return routed
+    inputs = _as_object(dynamic_node.get("inputs", {}), "dynamic LoRA inputs")
+    upstream = inputs.get("model")
+    if not isinstance(upstream, list) or len(upstream) != 2:
+        raise ValueError("Dynamic LoRA node has no valid model input")
+
+    consumers: list[tuple[JsonObject, str]] = []
+    for raw_node in routed.values():
+        if not isinstance(raw_node, dict):
+            continue
+        node_inputs = raw_node.get("inputs")
+        if not isinstance(node_inputs, dict):
+            continue
+        for input_name, input_value in list(node_inputs.items()):
+            if (
+                isinstance(input_value, list)
+                and len(input_value) == 2
+                and str(input_value[0]) == dynamic_id
+            ):
+                consumers.append((cast(JsonObject, node_inputs), input_name))
+
+    if not selections:
+        for node_inputs, input_name in consumers:
+            node_inputs[input_name] = copy.deepcopy(upstream)
+        del routed[dynamic_id]
+        return routed
+
+    inputs["model"] = copy.deepcopy(upstream)
+    inputs["lora_name"] = selections[0]["filename"]
+    inputs["strength_model"] = selections[0]["strength"]
+    previous_id = dynamic_id
+    numeric_ids = [int(node_id) for node_id in routed if str(node_id).isdigit()]
+    next_id = max(numeric_ids, default=0) + 1
+    for selection in selections[1:]:
+        clone = cast(JsonObject, copy.deepcopy(dynamic_node))
+        clone_inputs = _as_object(clone.get("inputs", {}), "dynamic LoRA clone inputs")
+        clone_inputs["model"] = [previous_id, 0]
+        clone_inputs["lora_name"] = selection["filename"]
+        clone_inputs["strength_model"] = selection["strength"]
+        clone_meta = clone.get("_meta")
+        if isinstance(clone_meta, dict):
+            clone_meta["title"] = f"Krea2 프리셋 LoRA {next_id}"
+        clone_id = str(next_id)
+        routed[clone_id] = clone
+        previous_id = clone_id
+        next_id += 1
+
+    for node_inputs, input_name in consumers:
+        node_inputs[input_name] = [previous_id, 0]
+    return routed
+
+
+def apply_resolution(workflow: JsonObject, resolution: Resolution) -> JsonObject:
+    """Apply validated width and height to the API workflow primitive nodes."""
+
+    applied = validate_resolution(resolution)
+    routed = cast(JsonObject, copy.deepcopy(workflow))
+    title_to_key = {"Image Width": "width", "Image Height": "height"}
+    found: set[str] = set()
+    for raw_node in routed.values():
+        if not isinstance(raw_node, dict):
+            continue
+        node = cast(JsonObject, raw_node)
+        meta = node.get("_meta")
+        if not isinstance(meta, dict):
+            continue
+        key = title_to_key.get(meta.get("title"))
+        if key is None:
+            continue
+        inputs = _as_object(node.get("inputs", {}), f"{key} inputs")
+        inputs["value"] = applied[key]
+        found.add(key)
+    if found != {"width", "height"}:
+        raise ValueError("Krea2 API workflow is missing Image Width or Image Height")
+    return routed
