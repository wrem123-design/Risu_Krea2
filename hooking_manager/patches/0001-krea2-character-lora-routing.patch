+    """Read or update immutable-filename Krea2 character LoRA mappings."""
+
+    try:
+        if request.method == "GET":
+            return web.json_response(_build_krea2_lora_response())
+
+        body = await request.json()
+        incoming = body.get("entries", []) if isinstance(body, dict) else []
+        if not isinstance(incoming, list):
+            return web.json_response(
+                {"success": False, "error": "entries는 목록이어야 합니다."},
+                status=400,
+            )
+        catalog = load_power_lora_catalog(_get_krea2_catalog_source_path())
+        validated = validate_mapping_entries(catalog, incoming)
+        current_routes = load_preset_routes(Path(KREA2_LORA_MAPPING_FILE))
+        incoming_routes = body.get("preset_routes", current_routes)
+        if not isinstance(incoming_routes, list):
+            return web.json_response(
+                {"success": False, "error": "preset_routes는 목록이어야 합니다."},
+                status=400,
