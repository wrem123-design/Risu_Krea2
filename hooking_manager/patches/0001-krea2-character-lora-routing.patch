+def _get_krea2_catalog_source_path() -> Path:
+    """Return the configured read-only source workflow for LoRA discovery."""
+
+    configured = str(app_config.get("krea2_lora_catalog_source_path", "")).strip()
+    if not configured:
+        raise ValueError("Krea2 LoRA 카탈로그 원본 워크플로우 경로가 설정되지 않았습니다.")
+    source = Path(configured)
+    if not source.is_file():
+        raise FileNotFoundError(f"Krea2 LoRA 원본 워크플로우를 찾을 수 없습니다: {source}")
