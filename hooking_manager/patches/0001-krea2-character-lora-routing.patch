+def _build_krea2_lora_response() -> dict[str, object]:
+    """Build frontend data from the workflow catalog and persisted overrides."""
+
+    source = _get_krea2_catalog_source_path()
+    catalog = load_power_lora_catalog(source)
+    mapping_path = Path(KREA2_LORA_MAPPING_FILE)
+    saved = load_mapping_file(mapping_path)
+    validated_saved = validate_mapping_entries(catalog, list(saved)) if saved else []
+    saved_routes = load_preset_routes(mapping_path)
+    preset_routes = validate_preset_routes(catalog, list(saved_routes))
+    entries = merge_catalog_with_mappings(catalog, validated_saved)
+    default_resolution = load_workflow_resolution(source)
+    resolution = load_resolution_override(mapping_path) or default_resolution
+    return {
+        "success": True,
+        "source_path": str(source),
+        "mapping_path": KREA2_LORA_MAPPING_FILE,
+        "entries": entries,
+        "preset_routes": preset_routes,
+        "resolution": {
+            "width": resolution["width"],
+            "height": resolution["height"],
+            "default_width": default_resolution["width"],
+            "default_height": default_resolution["height"],
+        },
+        "mapped_count": sum(1 for entry in entries if entry["character_name"]),
